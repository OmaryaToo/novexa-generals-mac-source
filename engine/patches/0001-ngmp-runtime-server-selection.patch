+// NOVEXA @feature 22/11/2026 Runtime server selection: NGMP_SERVER_HOST / NGMP_SERVER_PORT /
+// NGMP_SERVER_SSL / NGMP_WEB_PORTAL_URL environment variables override the compile-time
+// defaults, so a launcher can point one build at the official, a LAN or a private server.
+static std::string EnvOr(const char* name, const char* fallback) {
+    const char* v = getenv(name);
+    return (v && v[0] != '\0') ? std::string(v) : std::string(fallback);
+}
+static std::string ServerHost() { return EnvOr("NGMP_SERVER_HOST", NGMP_DEFAULT_HOST); }
+static std::string ServerPort() { return EnvOr("NGMP_SERVER_PORT", NGMP_DEFAULT_PORT); }
